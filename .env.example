# Firebase web configuration and server-only service-account JSON
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_ADMIN_CREDENTIALS=
APP_BASE_URL=http://localhost:3000

# Google Sheets server-side settings
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=

# Tamasha reporting sheet. Grant the account above Viewer access or configure a dedicated account.
TAMASHA_GOOGLE_SPREADSHEET_ID=""
TAMASHA_GOOGLE_SERVICE_ACCOUNT_JSON=""

# Optional Gemini summaries
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Local or Vercel Preview only. Use a separate Firebase project with private Firestore rules.
PORTAL_TOTP_PREVIEW=0
PORTAL_TOTP_KEY=
# Production pilot. Keep the activation hash server-side and set only the approved tester's email.
PORTAL_TOTP_PILOT_EMAIL=
PORTAL_TOTP_PILOT_ACTIVATION_HASH=
