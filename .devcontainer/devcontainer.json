{
  "name": "SIMOSA Next.js",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-24-bookworm",
  "postCreateCommand": "npm ci",
  "postAttachCommand": {
    "server": "npm run dev"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "SIMOSA Dashboard",
      "onAutoForward": "openPreview"
    }
  }
}
